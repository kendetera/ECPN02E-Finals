# Copy this file to .env and fill in the values. Never commit .env.

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (sb_secret_... or the legacy service_role key). Server only.
SUPABASE_SECRET_KEY=

# Long random string used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3000
# Set to true only once the site is served over HTTPS (e.g. after DuckDNS + Caddy).
COOKIE_SECURE=false
